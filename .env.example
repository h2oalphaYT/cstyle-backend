# ─────────────────────────────────────────────────────────────
# CStyle backend — copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB
#   Local (npm run db:local, or your own mongod):
MONGODB_URI=mongodb://127.0.0.1:27017/cstyle
#   MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cstyle?retryWrites=true&w=majority
# Optional: overrides the database name in the URI
MONGODB_DB_NAME=

# Auth — use a long random string (at least 32 characters in production), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173

# Public URL of this API. Image URLs in API responses are built from it,
# e.g. http://localhost:5000/uploads/products/product-68f23a91-1.webp
API_BASE_URL=http://localhost:5000

# Image uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Store settings (amounts in LKR)
CURRENCY=LKR
SHIPPING_FEE=1500
FREE_SHIPPING_THRESHOLD=30000

# Accounts created by `npm run seed` (development / first setup only)
SEED_ADMIN_EMAIL=admin@cstyle.lk
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@cstyle.lk
SEED_CUSTOMER_PASSWORD=
