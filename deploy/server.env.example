# Production settings for the server. Copy to .env in the cstyle-backend folder:
#   cp deploy/server.env.example .env && nano .env
# NODE_ENV, PORT, UPLOAD_DIR and HR_FILES_DIR are set by docker-compose.yml.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.opigyca.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=cStyle

# At least 32 random characters. Generate one on the server with:
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Storefront addresses on Vercel, comma separated, no trailing slash.
FRONTEND_URL=https://www.cstylecollective.com,https://cstylecollective.com

# Public HTTPS address of this API (image URLs are built from it).
API_BASE_URL=https://api.cstylecollective.com

MAX_FILE_SIZE=5242880

CURRENCY=LKR
SHIPPING_FEE=1500
FREE_SHIPPING_THRESHOLD=30000

# Used by `npm run seed:admin` to create the admin account. Pick a strong password.
SEED_ADMIN_EMAIL=admin@cstylecollective.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

HR_TZ_OFFSET=+05:30
HR_MAX_FILE_SIZE=10485760
