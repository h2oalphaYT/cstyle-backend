{
    "name": "cstyle-backend",
    "version": "1.0.0",
    "description": "REST API for the CStyle e-commerce storefront and admin panel",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon --ignore uploads/ --ignore .mongo-data/ server.js",
        "seed": "node scripts/seed.js",
        "seed:fresh": "node scripts/seed.js --fresh",
        "seed:admin": "node scripts/seed.js --admin-only",
        "db:local": "node scripts/db-local.js",
        "test": "node --test tests/api.test.js",
        "migrate": "node scripts/migrate-payroll.js",
        "payroll:demo": "node scripts/seed-payroll-demo.js",
        "payroll:remove-demo": "node scripts/remove-payroll-demo.js",
        "setup:garment": "node scripts/setup-garment.js",
        "test:payroll": "node --test tests/payroll.test.js",
        "test:sheet": "node --test tests/monthly-sheet.test.js",
        "test:garment": "node --test tests/garment.test.js",
        "import:staff": "node scripts/import-staff.js"
    },
    "keywords": [
        "ecommerce",
        "api",
        "mongodb",
        "express"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.3.0",
        "mongoose": "^8.0.3",
        "multer": "^1.4.5-lts.1",
        "pdfkit": "^0.20.2",
        "sharp": "^0.34.5",
        "uuid": "^13.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.0.2"
    },
    "engines": {
        "node": ">=18.18"
    }
}
